# core/k8s/Dockerfile.web -- static frontend + nginx for Kubernetes.
#
# Build context: repository root. Only core/frontend and each module's
# frontend/ folder are baked in. Backend source (routes.py, table_core.py,
# schema.sql) never reaches this image, unlike the Compose setup where all
# of modules/ is mounted into nginx.

FROM busybox:1.37.0 AS assemble

COPY core/frontend /out
COPY modules /src/modules

# Keep only modules/<name>/frontend, skipping stub folders such as _template.
RUN set -eu; \
    for dir in /src/modules/*/; do \
        name="$(basename "$dir")"; \
        case "$name" in _*) continue ;; esac; \
        if [ -d "${dir}frontend" ]; then \
            mkdir -p "/out/modules/${name}"; \
            cp -r "${dir}frontend" "/out/modules/${name}/frontend"; \
        fi; \
    done

FROM ghcr.io/nginxinc/nginx-unprivileged:stable-alpine

ARG SOURCE_URL=""
LABEL org.opencontainers.image.source="${SOURCE_URL}"

# Replaces only the server block. The image's own nginx.conf is kept: it
# already moves the pid and temp paths to /tmp for a non-root user.
COPY core/k8s/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=assemble /out /usr/share/nginx/html

EXPOSE 8080
