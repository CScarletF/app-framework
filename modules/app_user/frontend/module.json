{
    "table": "app_user",
    "label": "Users",
    "order": 90,
    "default": false,
    "columns": [
        { "key": "username", "label": "Username" },
        { "key": "role", "label": "Role" },
        { "key": "active", "label": "Active" },
        { "key": "locked_until", "label": "Locked Until", "format": "datetime" }
    ],
    "form": [
        { "key": "username", "label": "Username", "type": "text", "required": true },
        { "key": "password_hash", "label": "Password", "type": "password" },
        { "key": "role", "label": "Role", "type": "select", "required": true,
          "options": ["staff", "admin"] },
        { "key": "active", "label": "Active", "type": "select",
          "options": ["true", "false"] }
    ]
}
