DB_HOST=192.168.20.190
# Port 5000, not 5432 -- this is the Keepalived VIP's HAProxy "master"
# listener (routes to whichever node is currently Patroni primary), not
# a direct Postgres connection.
DB_PORT=5000
DB_NAME=webapp_demo
DB_USER=webapp_app
DB_PASSWORD=
APP_ENV=production
APP_DEBUG=false

# --- Authentication (enforced whenever modules/app_user is present) ---
# Session cookie signing key. Minimum 32 characters, must be identical for
# every gunicorn worker. Leave blank and run setup.py -- it generates one.
SECRET_KEY=
# Idle session lifetime in minutes (sliding: refreshed on each request).
SESSION_LIFETIME_MINUTES=480
# Set true only when the app is served over HTTPS.
SESSION_COOKIE_SECURE=false
# Seed account, created ONLY if no admin exists yet. Changing these later
# does not touch an existing account -- change passwords inside the app.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Account lockout after repeated failed logins.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Applies to passwords set through the app (not to the seed account).
PASSWORD_MIN_LENGTH=8
