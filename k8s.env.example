# Copy to k8s.env (gitignored) and fill in. Read by deploy_k8s.py.
# Database and auth settings come from .env, NOT from this file.

# Image registry path and base name. Images are named
#   <K8S_REGISTRY>/<K8S_IMAGE_BASENAME>-app:<tag>
#   <K8S_REGISTRY>/<K8S_IMAGE_BASENAME>-web:<tag>
# GHCR requires a lowercase path.
K8S_REGISTRY=ghcr.io/cscarletf
K8S_IMAGE_BASENAME=app-framework

K8S_NAMESPACE=app-framework

# Node the pod prefers (a preference, not a requirement).
K8S_PREFERRED_NODE=jenkins

# Links the GHCR package to the repository.
SOURCE_URL=https://github.com/CScarletF/app-framework

# GitHub username, a token with write:packages for pushing (used by
# `docker login` on the build host), and a SEPARATE token with only
# read:packages for the cluster's image pull secret. Leave the pull token
# blank only if the images are public.
GHCR_USER=
GHCR_PUSH_TOKEN=
GHCR_PULL_TOKEN=
